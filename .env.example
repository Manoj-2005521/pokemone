# ========================================================
# Pokédex Go — Telegram Bot Configuration
# ========================================================

# [REQUIRED] Telegram Bot Token from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# [OPTIONAL] Numeric Telegram User ID of the administrator
# Enables /health command and receives alerts after repeated unhandled errors
# Get your ID from @userinfobot or @raw_data_bot on Telegram
BOT_ADMIN_ID=

# [OPTIONAL] Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# [OPTIONAL] Port for web service health check (auto-set by Render)
PORT=10000

# [OPTIONAL] Path to SQLite database file (default: pokedex.db)
DB_PATH=pokedex.db

# [OPTIONAL] Primary local backup directory (default: backups/)
BACKUP_DIR=backups

# [OPTIONAL] Secondary remote backup directory (e.g. cloud-sync mount)
BACKUP_REMOTE_DIR=

# [OPTIONAL] Number of backup snapshots to retain (default: 14)
BACKUP_RETENTION=14

# [OPTIONAL] NASA API key for /space APOD command (default: DEMO_KEY)
NASA_KEY=DEMO_KEY
